# Firedancer config TEMPLATE for a FIREDANCER standby of an AGAVE primary
# (PRIMARY_CLIENT=agave, STANDBY_CLIENT=firedancer). The default for an Agave primary is an Agave
# standby, which does not need this file.
# Copy to /etc/ods/standby-firedancer.toml, fill it in once, and set STANDBY_FD_TEMPLATE.
# A Firedancer primary does not need this file: its standby config is derived from its own TOML.
#
# Best starting point: a WORKING mainnet config of the same Firedancer build as STANDBY_FD_BIN
# (e.g. from another validator you run on Firedancer), not this file. ods only needs it to
# be valid for that binary; every key below other than the ones marked "ods" is plain
# Firedancer configuration: check it against the default config of YOUR build, key names change
# between versions.
#
# `ods bundle` ALWAYS overrides, so leave them out or at any value:
#   [paths] identity_key   -> a junk key generated on the standby (staked only via ods-swap)
#   [paths] base / snapshots / accounts, [log] path -> standby disk layout
#   [paths] vote_history   -> removed (default: inside base)
#   [net] interface / provider -> discovered NIC, socket provider
#   [tiles.shred] additional_shred_destinations_leader -> multicast entries dropped (STANDBY_DROP_MULTICAST)
#
# MIRROR your primary: the same block-building setup as your Agave command line, nothing more.
# Jito (--block-engine-url) -> [tiles.bundle]; Jito BAM (--bam-url) -> a BAM-capable build (FireBAM)
# and its BAM settings; Harmonic -> Harmonic's Firedancer build (Samba) and its [tiles.bundle] keys;
# --shred-receiver-address -> [tiles.shred] additional_shred_destinations_leader. None of them on the
# primary -> none here. `ods doctor` compares the providers of both. Any region will do: the
# standby re-points them to the region closest to itself (config/regional-endpoints.conf).

name = "fd1"              # ods: standby layout uses /mnt/ods-ledger/<name>
user = "firedancer"       # ods: created on the standby; owns ledger, keys, vote history

[paths]
    # Your vote account (as your Firedancer version expects it: check its default config).
    vote_account = "REPLACE_WITH_YOUR_VOTE_ACCOUNT"

[snapshots.sources.gossip]
    # Trusted snapshot servers (here: snappie.sh). Use the same as your primary's --known-validator.
    allow_any = false
    allow_list = ["snappieAMus13pmFwd8aDPKDHTTVYWo6y41zSpasU8L"]

[gossip]
    entrypoints = [
        "entrypoint.mainnet-beta.solana.com:8001",
        "entrypoint2.mainnet-beta.solana.com:8001",
        "entrypoint3.mainnet-beta.solana.com:8001",
    ]

[tiles.metric]
    prometheus_listen_port = 7999   # ods: status/lag of the standby are read here (over SSH)

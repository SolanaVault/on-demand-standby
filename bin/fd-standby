#!/usr/bin/env bash
# fd-standby: rent an hourly bare-metal server, turn it into a caught-up Firedancer standby,
# move the staked identity there while THIS primary is maintained, move it back, delete it.
#
#   fd-standby doctor                      check config, keys, APIs, primary; changes nothing
#   fd-standby stock [--any]               in-stock candidates, cheapest first (--any: unqualified too)
#   fd-standby bundle                      build the standby bundle from this primary's binary + config
#   fd-standby up [--plan P [--region R]]  rent + set up + wait until caught up (prints the IP)
#   fd-standby status                      current standby, identities, tagged servers
#   fd-standby down [--force]              shred any staked key on the standby, delete it, verify
#   fd-standby maintain [--yes] [-- CMD..] up -> swap -> CMD here (default: restart Firedancer)
#                                          -> wait until caught up -> swap back -> down
#   fd-standby qualify PROVIDER PLAN REGION   prove a server type end to end (throwaway keys only)
#   fd-standby qualify-queue [--max N]     qualify every unqualified in-stock type (N per run)
#   fd-standby watchdog                    (timer) alert on / delete forgotten standbys
#
# Safety model: see SAFETY.md. The staked key only moves inside fd-standby-swap.
set -uo pipefail
# shellcheck source=../lib/common.sh
. "$(dirname "$(readlink -f "$0")")/../lib/common.sh"
# shellcheck source=../lib/provider-cherry.sh
. "$FDS_ROOT/lib/provider-cherry.sh"
# shellcheck source=../lib/provider-vultr.sh
. "$FDS_ROOT/lib/provider-vultr.sh"
SWAP="$FDS_ROOT/bin/fd-standby-swap"
PROVIDERS="cherry vultr"

# ------------------------------------------------------------------ candidates / stock
candidates(){  # prints "provider plan region" rows allowed by qualification + --any
  grep -vE '^\s*(#|$)' "$CANDIDATES_FILE" | while read -r prov plan region qual _; do
    [ "$qual" = off ] && continue
    [ "${ANY:-0}" = 1 ] || [ "$qual" = yes ] || continue
    echo "$prov $plan $region"
  done
}
stock_lines(){
  local c p; c=$(candidates)
  for p in $PROVIDERS; do
    "${p}_enabled" || continue
    echo "$c" | awk -v p="$p" '$1==p' | "${p}_stock"
  done | sort -k4 -n | awk -v cap="$MAX_PRICE_PER_HOUR" '$4<=cap'
}

# ------------------------------------------------------------------ bundle
BUNDLE_TGZ=$FDS_STATE_DIR/bundle.tgz
bundle(){
  local d real rel; d=$(mktemp -d); real=$(readlink -f "$FD_BIN")
  rel=$(basename "$(dirname "$real")"); [ "$rel" = bin ] && rel="fd-$("$FD_BIN" --version | awk '{print $1}')"
  mkdir -p "$d/bin" "$d/config" "$d/units"
  install -m 755 "$real" "$d/bin/firedancer"; echo "$rel" > "$d/bin/release"
  cp "$FDS_ROOT/standby/standby-init.sh" "$FDS_ROOT/standby/standby.nft.in" "$FDS_ROOT/standby/60-fd-tcp-rmem.conf" "$d/"
  cp "$FDS_ROOT"/standby/units/*.service "$d/units/"
  printf 'FD_USER=%q\nFD_NAME=%q\nCONFIGURE_STAGES=%q\n' "${P_USER:-firedancer}" "$P_NAME" "$STANDBY_CONFIGURE_STAGES" > "$d/config/standby.env"
  python3 -I - "$PRIMARY_FD_CONFIG" "$d/config/standby.toml.in" "$S_LED_MNT" "$S_ACC_MNT" "$S_JUNK_KEY" "${STANDBY_DROP_MULTICAST:-1}" <<'PY' || { rm -rf "$d"; die "cannot derive standby config"; }
import re, sys
src, dst, led, acc, junk, dropmc = sys.argv[1:]
s = open(src).read()
def setkey(section, key, value, comment):
    """replace key in [section] (top-level table only) or append it to the section"""
    global s
    m = re.search(r'(?m)^\[' + re.escape(section) + r'\]\s*$', s)
    line = f'    {key} = "{value}"   # {comment}'
    if not m:
        s += f'\n[{section}]\n{line}\n'; return
    nxt = re.search(r'(?m)^\[[^\]]+\]\s*$', s[m.end():])
    end = m.end() + (nxt.start() if nxt else len(s) - m.end())
    body = s[m.end():end]
    pat = r'(?m)^[ \t]*' + re.escape(key) + r'[ \t]*=.*$'
    body = re.sub(pat, line, body, count=1) if re.search(pat, body) else '\n' + line + body
    s = s[:m.end()] + body + s[end:]
setkey('paths', 'identity_key', junk, 'fd-standby: junk; staked only via fd-standby-swap')
setkey('paths', 'base', led + '/{name}', 'fd-standby: standby layout')
setkey('paths', 'snapshots', led + '/{name}/snapshots', 'fd-standby: standby layout')
setkey('paths', 'accounts', acc + '/accounts.db', 'fd-standby: standby layout')
for k in ('vote_history',):
    s = re.sub(r'(?m)^[ \t]*' + k + r'[ \t]*=.*\n', '', s)
setkey('log', 'path', led + '/{name}/firedancer.log', 'fd-standby: standby layout')
setkey('net', 'interface', '@IFACE@', 'fd-standby: discovered on the standby')
setkey('net', 'provider', 'socket', 'fd-standby: socket works on any NIC')
if dropmc == '1':
    def drop(m):
        items = [x for x in re.findall(r'"([^"]+)"', m.group(2)) if not 224 <= int(x.split('.')[0]) <= 239]
        return m.group(1) + '[ ' + ', '.join('"%s"' % x for x in items) + ' ]'
    s = re.sub(r'(?m)^(\s*additional_shred_destinations_leader\s*=\s*)\[(.*?)\]', drop, s)
import tomllib
t = tomllib.loads(s.replace('@IFACE@', 'eth0'))          # must stay valid TOML
assert t['paths']['identity_key'] == junk and t['net']['provider'] == 'socket'
assert t['paths']['accounts'].startswith(acc) and t['log']['path'].startswith(led)
open(dst, 'w').write(s)
PY
  tar -C "$d" -czf "$BUNDLE_TGZ" . && rm -rf "$d"
  say "bundle: $rel $(sha256sum "$real" | cut -c1-12) -> $BUNDLE_TGZ ($(du -h "$BUNDLE_TGZ" | cut -f1))"
}

# ------------------------------------------------------------------ server lifecycle helpers
# delete a server and VERIFY it is gone; keeps the state file until then. Returns 1 + alert if not gone.
destroy_verified(){ local prov=$1 id=$2 code
  code=$("${prov}_destroy" "$id")
  for _ in $(seq 1 18); do [ "$("${prov}_state" "$id")" = gone ] && { say "server $id deleted (http $code) and gone"; return 0; }; sleep 10; done
  alert "server $prov $id still exists 3 min after delete (http $code) - CHECK THE PROVIDER, it may be billing"; return 1; }
# a create call that failed may still have created a server: delete tagged servers younger than $1 that we do not know
cleanup_orphans(){ local since=$1 prov id ip created known; known=$(state_get id)
  while read -r prov id ip created <&3; do
    [[ "$created" =~ ^[0-9]+$ ]] || continue
    (( created >= since - 60 )) && [ "$id" != "$known" ] || continue
    say "orphan from a failed create: $prov $id ($ip) -> deleting"; destroy_verified "$prov" "$id" </dev/null
  done 3< <(list_tagged); }
# identity of a standby: staked | junk | other | unknown (unknown = SSH/CLI failure, NEVER "not staked")
standby_state(){ local ip=$1 id junk
  id=$(s_id "$ip" </dev/null 2>/dev/null); junk=$(keypub_remote "$ip" "$S_JUNK_KEY" </dev/null 2>/dev/null)
  if ! [[ "$id" =~ ^$B58$ ]]; then echo unknown; elif [ "$id" = "$STAKED_PUBKEY" ]; then echo staked
  elif [ "$id" = "$junk" ]; then echo junk; else echo other; fi; }
# a standby may be deleted only if we KNOW it does not vote: it reports a non-staked identity,
# or THIS primary positively runs the staked identity (then the standby cannot be the voter)
safe_to_delete(){ local ip=$1 st
  [ "$(p_id)" = "$STAKED_PUBKEY" ] && return 0
  valid_ip "$ip" || return 1
  st=$(standby_state "$ip"); [ "$st" = junk ] || [ "$st" = other ]; }

# ------------------------------------------------------------------ up / down
up(){
  if [ -s "$FDS_STATE" ]; then
    local sp sid sst; sp=$(state_get provider); sid=$(state_get id)
    sst=$("${sp}_state" "$sid" | cut -d' ' -f1)
    if [ "$sst" != gone ]; then
      valid_ip "$(state_get ip)" || die "an unfinished standby exists ($sp $sid, no IP yet) - wait or run: fd-standby down"
      say "standby already exists: $sp $sid $(state_get ip)"; state_get ip; return 0; fi
    rm -f "$FDS_STATE"
  fi
  bundle
  local cands prov plan region price id t0 s ip="" tc pip
  pip=$(primary_ip); valid_ip "$pip" || die "cannot determine this primary's public IP"
  if [ -n "${PLAN:-}" ]; then cands=$(ANY=1 stock_lines | awk -v p="$PLAN" -v r="${REGION:-}" '$2==p && (r=="" || $3==r)')
  else cands=$(stock_lines); fi
  [ -n "$cands" ] || die "no qualified candidate in stock under $MAX_PRICE_PER_HOUR/h (try later, or: fd-standby stock --any)"
  say "candidates in stock:"; echo "$cands" | sed 's/^/    /' >&2
  # fd 3: commands inside the loop (ssh!) must not consume the candidate list on stdin
  while read -r prov plan region price <&3; do
    say "creating $prov $plan in $region (~$price/h)"
    tc=$(date +%s)
    id=$("${prov}_create" "$plan" "$region" "fd-standby-$(date -u +%m%d%H%M)" </dev/null)
    if [ -z "$id" ]; then say "create failed, next candidate"; sleep 20; cleanup_orphans "$tc"; continue; fi
    t0=$(date +%s); ip=""; state_put "$prov" "$id" - "$plan" "$region" "$t0"
    say "created $prov server $id; waiting for delivery"
    while :; do
      s=$("${prov}_state" "$id" </dev/null); case "$s" in ready*) ip=${s#ready }; break;; gone) say "server $id vanished"; break;; esac
      if (( $(date +%s)-t0 > DELIVERY_MAX_S )); then say "server $id not delivered within $((DELIVERY_MAX_S/60)) min -> deleting, next candidate"; break; fi
      sleep 20
    done
    if ! valid_ip "$ip"; then destroy_verified "$prov" "$id" </dev/null && rm -f "$FDS_STATE"; continue; fi
    state_put "$prov" "$id" "$ip" "$plan" "$region" "$t0"
    for _ in $(seq 1 60); do sshs "$ip" true </dev/null 2>/dev/null && break; sleep 10; done
    say "delivered in $(( ($(date +%s)-t0)/60 )) min: $ip"
    if ! sshs "$ip" "rm -rf /root/fd-standby-bundle && mkdir -p /root/fd-standby-bundle && tar -C /root/fd-standby-bundle -xzf -" < "$BUNDLE_TGZ"; then
      say "bundle upload failed -> deleting, next candidate"; destroy_verified "$prov" "$id" </dev/null && rm -f "$FDS_STATE"; continue; fi
    init(){ sshs "$ip" "/root/fd-standby-bundle/standby-init.sh --primary-ip $pip ${STANDBY_EXTRA_SSH_SOURCES:+--extra-ssh $(printf %q "$STANDBY_EXTRA_SSH_SOURCES")} $1" </dev/null 2>&1 | tee -a "$FDS_LOG"; }
    if ! init --check-only | grep '^RESULT {"ok":true' >/dev/null; then
      say "hardware check failed on $plan -> deleting, next candidate"; destroy_verified "$prov" "$id" </dev/null && rm -f "$FDS_STATE"; continue; fi
    # firewall FIRST, then confirm it with a NEW login right away (the box rolls it back after 3 min otherwise)
    init --firewall | grep -E '^\[|^RESULT' >&2
    sshs "$ip" "touch /run/fd-standby-fw-ok" </dev/null || die "cannot SSH after loading the firewall (it rolls back in 3 min); server $prov $id left for inspection"
    init --setup | grep -E '^\[|^RESULT' | tee /dev/stderr | grep '^RESULT {"ok":true' >/dev/null \
      || die "standby setup failed on $ip (left for inspection: fd-standby down)"
    say "waiting for the standby to catch up"
    local w=0
    until sshs "$ip" "grep 'caught up to cluster' $S_LOG >/dev/null" </dev/null 2>/dev/null; do
      sleep 15; w=$((w+15)); ((w>CATCHUP_MAX_S)) && die "standby $ip did not catch up in $((CATCHUP_MAX_S/60)) min (left running: fd-standby down)"; done
    sshs "$ip" "grep -h 'caught up to cluster' $S_LOG | tail -1" </dev/null | sed 's/.*\]: /  /' >&2
    say "standby ready: $prov $plan $region $ip (total $(( ($(date +%s)-t0)/60 )) min)"
    echo "$ip"; return 0
  done 3<<< "$cands"
  die "all candidates failed"
}

down(){
  [ -s "$FDS_STATE" ] || { say "no standby in state file"; return 0; }
  local prov id ip; prov=$(state_get provider); id=$(state_get id); ip=$(state_get ip)
  if ! safe_to_delete "$ip"; then
    [ "${FORCE:-0}" = 1 ] || die "standby $ip may hold the staked identity (state: $(standby_state "$ip")) and this primary is not staked - refusing. Fix first (fd-standby-swap status $ip), or --force"
    alert "FORCED delete of standby $ip in state $(standby_state "$ip")"; fi
  if valid_ip "$ip"; then sshs "$ip" "shred -u /run/fd-standby/* 2>/dev/null; test ! -e $S_STAKED_KEY" </dev/null 2>/dev/null || say "note: could not verify key removal on $ip (it is in tmpfs and dies with the server)"; fi
  destroy_verified "$prov" "$id" || die "server $id not confirmed gone (state file kept)"
  say "ran $(( ($(date +%s)-$(state_get created))/60 )) min"; rm -f "$FDS_STATE"
}

list_tagged(){ local p; for p in $PROVIDERS; do "${p}_enabled" && "${p}_list_tagged"; done; }

status(){
  if [ -s "$FDS_STATE" ]; then cat "$FDS_STATE"; echo; valid_ip "$(state_get ip)" && "$SWAP" status "$(state_get ip)"; else echo "no standby"; fi
  echo "tagged servers at providers:"; list_tagged | sed 's/^/  /'
}

# ------------------------------------------------------------------ maintain
wait_primary_caught_up(){  # since epoch $1, standby IP $2 (must keep voting meanwhile)
  local since; since=$(date -u -d "@$1" '+%F %T'); local warned=0
  for _ in $(seq 1 $((CATCHUP_MAX_S/15))); do
    if [ "$(standby_state "$2")" != staked ] && ((warned==0)); then
      alert "standby $2 no longer reports the staked identity during maintenance ($(standby_state "$2")) - CHECK: maybe nobody votes"; warned=1; fi
    systemctl is-active --quiet "$FD_UNIT" && awk -v s="$since" '$2" "substr($3,1,8)>=s' "$P_LOG" | grep 'caught up to cluster' >/dev/null && return 0
    sleep 15; done; return 1
}
# run fd-standby-swap; retry ONLY while it reports "refused, nothing changed" (exit 2)
swap_retry(){ local n=$1 rc; shift
  for _ in $(seq 1 "$n"); do "$SWAP" "$@" --yes --verify=30 </dev/null; rc=$?; [ $rc = 2 ] || return $rc; sleep 20; done; return 2; }
maintain(){
  local cmd=("$@"); [ ${#cmd[@]} -gt 0 ] || cmd=(systemctl restart "$FD_UNIT")
  say "MAINTAIN: primary command: ${cmd[*]}"
  [ "$(p_id)" = "$STAKED_PUBKEY" ] || die "primary is not running the staked identity - nothing to protect"
  [ "${YES:-0}" = 1 ] || { read -r -p "  >>> rent a standby, move the STAKED identity to it, run the command here, move back? [yes/NO] " a </dev/tty; [ "$a" = yes ] || die "not confirmed"; }
  local ip rc; ip=$(up) || { [ -s "$FDS_STATE" ] && down; exit 1; }
  "$SWAP" rehearse "$ip" </dev/null >/dev/null 2>&1 || { down; die "rehearsal on standby failed (standby deleted)"; }
  swap_retry 6 to-standby "$ip"; rc=$?
  case $rc in
    0) ;;
    2) down; die "swap to standby refused repeatedly - nothing changed, standby deleted";;
    *) die "swap to standby INCOMPLETE (see alert for the actual state) - nothing deleted, check manually";;
  esac
  local t pid0; t=$(date +%s); pid0=$(systemctl show -p MainPID --value "$FD_UNIT")
  say "running on primary: ${cmd[*]}"
  "${cmd[@]}" </dev/null || die "maintenance command failed; the staked identity stays on standby $ip (voting: $(standby_state "$ip"))"
  if [ "$(systemctl show -p MainPID --value "$FD_UNIT")" = "$pid0" ]; then say "Firedancer was not restarted by the command - no catch-up wait"
  else wait_primary_caught_up "$t" "$ip" || die "primary did not catch up; the staked identity stays on standby $ip (voting: $(standby_state "$ip"))"
    say "primary caught up after $(( ($(date +%s)-t)/60 )) min"; fi
  swap_retry 10 to-primary "$ip"; rc=$?
  [ $rc = 0 ] || die "swap back to primary failed (rc $rc); standby $ip left running (voting: $(standby_state "$ip"))"
  down
  say "MAINTAIN done"
}

# ------------------------------------------------------------------ qualify
qualify(){
  local prov=$1 plan=$2 region=$3 ip t cold
  [ -s "$FDS_STATE" ] && die "a standby exists (state file) - qualify only runs when no standby is in use"
  [[ "$prov $plan $region" =~ ^[a-z]+\ [A-Za-z0-9._-]+\ [A-Za-z0-9._-]+$ ]] || die "bad provider/plan/region"
  grep -qE "^$prov +$plan +$region " "$CANDIDATES_FILE" || echo "$prov $plan $region no" >> "$CANDIDATES_FILE"
  say "QUALIFY $prov $plan $region (throwaway keys only)"
  ip=$(PLAN=$plan REGION=$region up) || { [ -s "$FDS_STATE" ] && down; exit 1; }
  [ "$(state_get plan)" = "$plan" ] || { down; die "got a different plan"; }
  "$SWAP" rehearse "$ip" </dev/null || { down; die "rehearsal failed"; }
  t=$(date +%s); sshs "$ip" "rm -f $(printf %q "$S_BASE")/snapshots/*; systemctl restart firedancer" </dev/null
  sleep 60
  for _ in $(seq 1 $((CATCHUP_MAX_S/15))); do
    sshs "$ip" "awk -v s=\"$(date -u -d "@$t" '+%F %T')\" '\$2\" \"substr(\$3,1,8)>=s' $S_LOG | grep 'caught up to cluster' >/dev/null" </dev/null && break; sleep 15; done
  cold=$(( $(date +%s)-t ))
  local hw; hw=$(sshs "$ip" "nproc; awk '/MemTotal/{printf \"%d\", \$2/1048576}' /proc/meminfo; lsblk -dn -o SIZE,MODEL | tr -s ' ' | paste -sd ';'" </dev/null | paste -sd '|')
  "$SWAP" status "$ip" </dev/null
  down
  # same plan = same hardware: qualify the plan in every region (proven in $region)
  sed -i -E "s/^($prov +$plan +[A-Za-z0-9-]+ +)no\\b.*/\\1yes   # qualified $(date -u +%F) in $region, cold restart ${cold}s/" "$CANDIDATES_FILE"
  echo "$(date -u +%F) $prov $plan $region cold_restart_s=$cold hw=$hw" >> "$FDS_STATE_DIR/qualifications.log"
  say "QUALIFIED $prov $plan $region (cold restart to caught up: ${cold}s; $hw)"
}
qualify_queue(){
  local max=${MAX_N:-99} n=0 done_plans prov plan region price
  done_plans=" $(awk '$4=="yes"||$4=="off"{print $1":"$2}' "$CANDIDATES_FILE" | sort -u | tr '\n' ' ') "
  while read -r prov plan region price <&3; do
    case "$done_plans" in *" $prov:$plan "*) continue;; esac
    ((n>=max)) && break
    say "=== qualify $prov $plan $region ($price/h)"
    ( qualify "$prov" "$plan" "$region" ) </dev/null; say "=== rc=$?"
    done_plans="$done_plans$prov:$plan "; n=$((n+1))
  done 3< <(ANY=1 stock_lines)
}

# ------------------------------------------------------------------ watchdog
watchdog(){
  local now prov id ip created age st; now=$(date +%s)
  while read -r prov id ip created <&3; do
    [[ "$created" =~ ^[0-9]+$ ]] || { alert "watchdog: cannot read age of $prov $id"; continue; }
    age=$(( (now-created)/3600 ))
    (( age >= WATCHDOG_ALERT_AFTER_H )) && alert "standby $prov $id ($ip) running ${age} h"
    (( age < WATCHDOG_DELETE_AFTER_H )) && continue
    if ! safe_to_delete "$ip"; then
      st=$(valid_ip "$ip" && standby_state "$ip" || echo unknown)
      alert "standby $prov $id ($ip) is ${age} h old, state $st, NOT deleting (it may be voting)"; continue; fi
    alert "watchdog deleting forgotten standby $prov $id ($ip) after ${age} h"
    destroy_verified "$prov" "$id" </dev/null && { [ "$(state_get id)" = "$id" ] && rm -f "$FDS_STATE"; }
  done 3< <(list_tagged)
}

# ------------------------------------------------------------------ doctor (changes nothing)
doctor(){
  local bad=0 p
  chk(){ local d=$1; shift; if "$@" >/dev/null 2>&1; then printf '  ok   %s\n' "$d"; else printf '  FAIL %s\n' "$d"; bad=1; fi; }
  not_staked(){ [ "$(keypub_local "$1")" != "$STAKED_PUBKEY" ]; }
  staked_ok(){ [ "$(stat -c '%U %a' "$1")" = 'root 600' ] && [ "$(keypub_local "$1")" = "$STAKED_PUBKEY" ]; }
  metrics_ok(){ [ -n "$(p_metrics | metric replay_reset_slot)" ]; }
  echo "config: $FDS_CONF"
  chk "primary Firedancer config parses ($PRIMARY_FD_CONFIG)" test -n "$P_NAME"
  chk "Firedancer binary runs ($FD_BIN)" "$FD_BIN" --version
  chk "primary junk key exists ($P_JUNK_KEY)" test -s "$P_JUNK_KEY"
  chk "primary junk key is NOT the staked key" not_staked "$P_JUNK_KEY"
  chk "staked key present, root 0600, matches STAKED_PUBKEY" staked_ok "$PRIMARY_STAKED_KEY"
  chk "Firedancer running ($FD_UNIT)" systemctl is-active --quiet "$FD_UNIT"
  echo "  info running identity: $(p_id)  (staked: $STAKED_PUBKEY)"
  chk "metrics endpoint answers (port $P_METRICS_PORT)" metrics_ok
  chk "vote history dir exists ($P_VH_DIR)" test -d "$P_VH_DIR"
  chk "log file readable ($P_LOG)" test -r "$P_LOG"
  chk "SSH key for standbys ($SSH_KEY)" test -s "$SSH_KEY.pub"
  chk "candidates file ($CANDIDATES_FILE)" test -s "$CANDIDATES_FILE"
  chk "public RPC reachable" cluster_slot
  chk "this primary's public IP detectable" valid_ip "$(primary_ip)"
  for p in $PROVIDERS; do
    if "${p}_enabled"; then chk "$p API configured and answering" "${p}_list_tagged"; else echo "  --   $p not configured"; fi
  done
  [ -s "$FDS_STATE" ] && echo "  info a standby is recorded in $FDS_STATE: $(cat "$FDS_STATE")"
  echo "  info qualified candidates in stock now:"; stock_lines | sed 's/^/         /'
  return $bad
}

CMD=${1:-}; shift || true
YES=0; ANY=0; FORCE=0; PLAN=""; REGION=""; MAX_N=99
while [ $# -gt 0 ]; do case "$1" in
  --yes) YES=1;; --any) ANY=1;; --force) FORCE=1;; --plan) PLAN=$2; shift;; --region) REGION=$2; shift;;
  --max) MAX_N=$2; shift;; --) shift; break;; *) break;; esac; shift; done
export ANY PLAN REGION
case "$CMD" in
  ""|-h|--help|help) sed -n 2,19p "$0"; exit 0 ;;
  watchdog) [ -r "$FDS_CONF" ] || exit 0 ;;            # timer before configuration: nothing to do
esac
fds_load_config
case "$CMD" in
  up|down|maintain|qualify|qualify-queue|bundle) fds_lock_or_exit ;;
  watchdog) [ "${FDS_LOCK_HELD:-0}" = 1 ] || { exec 9>"$FDS_STATE_DIR/lock"; flock -n 9 || exit 0; export FDS_LOCK_HELD=1; } ;;
esac
case "$CMD" in
  doctor) doctor ;;
  stock) stock_lines ;;
  bundle) bundle ;;
  up) up ;;
  down) down ;;
  status) status ;;
  maintain) maintain "$@" ;;
  qualify) [ $# -eq 3 ] || { echo "usage: fd-standby qualify PROVIDER PLAN REGION"; exit 2; }; qualify "$@" ;;
  qualify-queue) qualify_queue ;;
  watchdog) watchdog ;;
  *) sed -n 2,19p "$0"; exit 2 ;;
esac

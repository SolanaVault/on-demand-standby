[Unit]
Description=Agave validator (fd-standby)
After=network-online.target fd-cpu-governor.service
Wants=network-online.target
RequiresMountsFor=@LED_MNT@ @ACC_MNT@
StartLimitIntervalSec=1800
StartLimitBurst=5

[Service]
Type=simple
User=@USER@
# The command line is the primary's (see `fd-standby bundle`) with --identity = the JUNK key:
# a crash or restart always comes back unstaked.
ExecStart=/opt/agave/standby-validator.sh
Restart=on-failure
RestartSec=30
TimeoutStopSec=300
LimitNOFILE=1000000
LimitMEMLOCK=infinity
LimitCORE=0

[Install]
WantedBy=multi-user.target
